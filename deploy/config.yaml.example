# Hermes config.yaml fragment. This is the *Hermes* config, not the backend's —
# the backend is configured entirely through environment variables (see
# deploy/hermes-tg-bridge.service) and its policy.json.

plugins:
  enabled:
    - hermes-telegram-user

gateway:
  platforms:
    telegram_user:
      enabled: true
      # Where cron jobs with deliver=telegram_user go (or set HERMES_TG_HOME_CHANNEL).
      # Must also be allowed by the backend write_to policy.
      home_channel:
        platform: telegram_user
        chat_id: "<your-telegram-user-id>"
        name: "Home"
      extra:
        bridge_url: "http://127.0.0.1:8765"
        # Same token as TELEGRAM_BRIDGE_API_TOKEN on the backend.
        # Prefer HERMES_TG_BRIDGE_API_TOKEN in the environment over a token here.
        api_token: "replace-with-the-same-token-as-the-backend"
        policy_profile: "dm_inbox"
        # Replace with your Telegram user IDs (e.g., ["123456789"]).
        # These only narrow the backend policy; they cannot widen it.
        allow_from: ["<your-telegram-user-id>"]
        write_to: ["<your-telegram-user-id>"]
        mark_read_on_inbound: true
        typing_while_replying: true
        poll_timeout_ms: 25000
        poll_interval_ms: 1500
