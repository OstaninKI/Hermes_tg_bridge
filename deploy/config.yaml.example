bridge:
  url: "http://127.0.0.1:8765"
  api_token: "replace-with-the-same-token-as-the-backend"
  policy_profile: "dm_inbox"

plugins:
  enabled:
    - hermes-telegram-user

gateway:
  platforms:
    telegram_user:
      enabled: true
      extra:
        bridge_url: "http://127.0.0.1:8765"
        policy_profile: "dm_inbox"
        # Replace with your Telegram user IDs (e.g., ["123456789"])
        allow_from: ["<your-telegram-user-id>"]
        write_to: ["<your-telegram-user-id>"]
        mark_read_on_inbound: true
        typing_while_replying: true
        poll_timeout_ms: 25000
        poll_interval_ms: 1500
