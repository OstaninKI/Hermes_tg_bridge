{
  "defaults": {
    "replyDelaySec": 0.0,
    "replyDelayMaxSec": 0.0,
    "read": {
      "allow": [],
      "deny": []
    },
    "write": {
      "allow": [],
      "deny": []
    },
    "sources": {
      "autoDiscover": false,
      "includeTypes": [],
      "excludePeers": [],
      "excludeUsernames": []
    }
  },
  "profiles": {
    "dm_inbox": {
      "read": {
        "allow": ["<your-telegram-user-id>"],
        "deny": []
      },
      "write": {
        "allow": ["<your-telegram-user-id>"],
        "deny": []
      },
      "replyDelaySec": 0.0,
      "replyDelayMaxSec": 0.0
    }
  },
  "_comment": "Replace '<your-telegram-user-id>' placeholders with actual Telegram user IDs before deploying"
}
