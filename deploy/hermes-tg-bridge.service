[Unit]
Description=Hermes Telegram Bridge backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-tg-bridge/backend
Environment=PYTHONUNBUFFERED=1
# Load secret token from file (must be mode 0600 with TELEGRAM_BRIDGE_API_TOKEN=...)
EnvironmentFile=-/etc/hermes-tg-bridge/secret.env
Environment=TELEGRAM_POLICY_PATH=/etc/hermes-tg-bridge/policy.json
Environment=TELEGRAM_BRIDGE_CONFIG_PATH=/etc/hermes-tg-bridge/config.yaml
# Optional tuning (defaults shown; uncomment to override):
# Environment=TELEGRAM_MAX_SENDS_PER_MIN=25
# Environment=TELEGRAM_FLOOD_WAIT_MAX_SLEEP_SEC=30
# Environment=TELEGRAM_IDEMPOTENCY_TTL_SEC=600
# Environment=TELEGRAM_IDEMPOTENCY_MAX_KEYS=1000
# Environment=HERMES_QR_PASSWORD_TIMEOUT=180
# Environment=TELEGRAM_DISABLE_EXTENDED_API=1
ExecStart=/opt/hermes-tg-bridge/backend/.venv/bin/hermes-tg-bridge run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
PrivateDevices=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hermes-tg-bridge /etc/hermes-tg-bridge
DynamicUser=false

[Install]
WantedBy=multi-user.target
