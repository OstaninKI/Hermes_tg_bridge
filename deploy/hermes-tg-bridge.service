[Unit]
Description=Hermes Telegram Bridge backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated account: the user that runs Hermes must NOT be able to read the
# Telegram session. Hermes only joins the hermes-tg group to read inbound media.
User=hermes-tg
Group=hermes-tg
# Files the backend creates are group-readable (media), never world-readable.
UMask=0027
WorkingDirectory=/opt/hermes-tg-bridge/backend
Environment=PYTHONUNBUFFERED=1
# TELEGRAM_API_ID, TELEGRAM_API_HASH, TELEGRAM_BRIDGE_API_TOKEN (root:hermes-tg, mode 0640)
EnvironmentFile=/etc/hermes-tg-bridge/secret.env
Environment=TELEGRAM_POLICY_PATH=/etc/hermes-tg-bridge/policy.json
# Private state (mode 0700): session, inbox cursors, lock
Environment=TELEGRAM_SESSION_PATH=/var/lib/hermes-tg-bridge/hermes_user.session
Environment=TELEGRAM_INBOX_STATE_PATH=/var/lib/hermes-tg-bridge/dm_inbox_state.json
Environment=TELEGRAM_SOURCES_INVENTORY_PATH=/var/lib/hermes-tg-bridge/sources_inventory.json
Environment=TELEGRAM_LOCK_PATH=/var/lib/hermes-tg-bridge/bridge.lock
# Inbound media (mode 2750, group hermes-tg): Hermes reads files from here
Environment=TELEGRAM_DM_MEDIA_PATH=/var/lib/hermes-tg-bridge-media
# Optional tuning (defaults shown; uncomment to override):
# Environment=TELEGRAM_MAX_SENDS_PER_MIN=25
# Environment=TELEGRAM_FLOOD_WAIT_MAX_SLEEP_SEC=30
# Environment=TELEGRAM_IDEMPOTENCY_TTL_SEC=600
# Environment=TELEGRAM_IDEMPOTENCY_MAX_KEYS=1000
# Environment=HERMES_QR_PASSWORD_TIMEOUT=180
# Environment=TELEGRAM_REPLY_DELAY_SEC=2
# What to do with messages that predate the first start:
#   unread (default) = answer whatever is still unread, none = only new arrivals,
#   all = replay recent history
# Environment=TELEGRAM_DM_INBOX_BACKFILL=unread
# Days to keep downloaded inbound media before it is swept (0 disables the sweep)
# Environment=TELEGRAM_DM_MEDIA_RETENTION_DAYS=7
# Leave only the endpoints the Hermes gateway needs; everything else returns 404
# Environment=TELEGRAM_DISABLE_EXTENDED_API=1
ExecStart=/opt/hermes-tg-bridge/backend/.venv/bin/hermes-tg-bridge run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
PrivateDevices=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hermes-tg-bridge /var/lib/hermes-tg-bridge-media
DynamicUser=false

[Install]
WantedBy=multi-user.target
